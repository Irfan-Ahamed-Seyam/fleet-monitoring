    {
      "id": 1,
      "title": "Agent status",
      "type": "stat",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "zabbix"
          },
          "group": {
            "filter": "Fleet"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "Zabbix agent ping"
          },
          "functions": [
            {
              "def": {
                "category": "Alias",
                "defaultParams": [],
                "name": "setAlias",
                "params": [
                  {
                    "name": "alias",
                    "type": "string"
                  }
                ]
              },
              "params": [
                "$__zbx_host_name"
              ],
              "text": "setAlias($__zbx_host_name)",
              "added": false
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "vertical"
      },
      "description": "1 = agent reporting. Active agents over TLS-PSK."
    },
