          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "options": {
            "minSeverity": 0,
            "acknowledged": 2,
            "sortProblems": "default",
            "hostsInMaintenance": false,
            "limit": 100,
            "showDisabledItems": false
          }
        }
      ],
      "options": {
        "layout": "table",
        "pageSize": 10,
        "hostField": true,
        "severityField": true,
        "ageField": true,
        "statusField": true,
        "descriptionField": false,
        "fontSize": "100%"
      }
    },
